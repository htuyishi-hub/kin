{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile --prefer-offline && pnpm --filter @workspace/kin run build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/kin run serve",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
